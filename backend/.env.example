# NEXUS Backend environment
# Copy to .env and fill in. Do NOT commit .env.

# CORS origins for the Vite dev server
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telemetry broadcast interval (seconds)
NEXUS_TELEMETRY_INTERVAL=1.0

# --- ElevenLabs (backend-mediated; keep the API key server-side only) ---
# Used to mint short-lived conversation tokens for the browser SDK.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
