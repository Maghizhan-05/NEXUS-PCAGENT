{
  "name": "nexus",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS — local AI system monitor & voice command center",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && .venv/Scripts/python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "install:frontend": "cd frontend && npm install",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --target=node18 --format=cjs --external:electron --external:systeminformation --outdir=dist-electron",
    "free-ports": "node scripts/free-ports.mjs",
    "electron:launch": "wait-on http://localhost:5173 && electron .",
    "electron:dev": "npm run free-ports && npm run electron:build && concurrently -k -n vite,electron -c magenta,green \"npm:dev:frontend\" \"npm:electron:launch\"",
    "electron:preview": "npm run electron:build && electron .",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && .venv/Scripts/python -m PyInstaller --onefile --name nexus-backend --collect-all uvicorn --collect-submodules app --hidden-import=websockets --hidden-import=httptools --noconfirm run.py",
    "dist": "npm run electron:build && npm run build:frontend && npm run build:backend && electron-builder --win",
    "dist:dir": "npm run electron:build && npm run build:frontend && npm run build:backend && electron-builder --win --dir"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nexus.systemhud",
    "productName": "NEXUS",
    "asar": true,
    "files": [
      "dist-electron/**/*",
      "package.json",
      "node_modules/systeminformation/**/*"
    ],
    "extraResources": [
      { "from": "frontend/dist", "to": "frontend" },
      { "from": "backend/dist/nexus-backend.exe", "to": "backend/nexus-backend.exe" }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "NEXUS-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NEXUS"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "systeminformation": "^5.33.12"
  }
}
